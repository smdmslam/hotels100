{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DMW Hotels 100 — Hotel Record",
  "description": "Canonical data structure for every hotel in the DMW Hotels 100 index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "edition",
    "rank",
    "name",
    "location",
    "archetype",
    "dmwJudgement",
    "publicationStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Permanent internal identifier that must not change between editions."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL-safe hotel identifier."
    },
    "edition": {
      "type": "integer",
      "minimum": 2026
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "previousRank": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "officialName": {
      "type": ["string", "null"]
    },
    "location": {
      "$ref": "#/$defs/location"
    },
    "coordinates": {
      "$ref": "#/$defs/coordinates"
    },
    "archetype": {
      "$ref": "#/$defs/archetype"
    },
    "strategicLens": {
      "$ref": "#/$defs/strategicLens"
    },
    "secondaryArchetypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/archetype"
      },
      "uniqueItems": true,
      "default": []
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "dmwJudgement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "One- or two-sentence judgement used in the ranked list."
    },
    "dmwOverview": {
      "type": ["string", "null"],
      "maxLength": 2500,
      "description": "Permanent profile introduction, normally 150–300 words."
    },
    "inclusionRationale": {
      "type": ["string", "null"]
    },
    "centralStrength": {
      "type": ["string", "null"]
    },
    "centralQuestion": {
      "type": ["string", "null"]
    },
    "bestSuitedFor": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "distinctions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/distinction"
      },
      "uniqueItems": true,
      "maxItems": 6,
      "default": []
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "propertyFacts": {
      "$ref": "#/$defs/propertyFacts"
    },
    "rates": {
      "$ref": "#/$defs/rates"
    },
    "amenities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amenity"
      },
      "default": []
    },
    "venues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/venue"
      },
      "default": []
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "businessTravel": {
      "$ref": "#/$defs/businessTravel"
    },
    "rooms": {
      "$ref": "#/$defs/rooms"
    },
    "pricingIntelligence": {
      "$ref": "#/$defs/pricingIntelligence"
    },
    "competitiveSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/competitor"
      },
      "default": []
    },
    "rankingAssessment": {
      "$ref": "#/$defs/rankingAssessment"
    },
    "fieldReports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldReport"
      },
      "default": []
    },
    "relatedArticleSlugs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      },
      "default": []
    },
    "links": {
      "$ref": "#/$defs/links"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "disclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disclosure"
      },
      "default": []
    },
    "editorial": {
      "$ref": "#/$defs/editorial"
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "country",
        "region",
        "displayLocation"
      ],
      "properties": {
        "addressLine1": {
          "type": ["string", "null"]
        },
        "addressLine2": {
          "type": ["string", "null"]
        },
        "neighbourhood": {
          "type": ["string", "null"]
        },
        "city": {
          "type": "string"
        },
        "stateOrProvince": {
          "type": ["string", "null"]
        },
        "postalCode": {
          "type": ["string", "null"]
        },
        "country": {
          "type": "string"
        },
        "countryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": "string",
          "enum": [
            "Europe",
            "North America",
            "Latin America and Caribbean",
            "Middle East",
            "Africa",
            "Asia",
            "Oceania"
          ]
        },
        "displayLocation": {
          "type": "string"
        }
      }
    },
    "coordinates": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "archetype": {
      "type": "string",
      "enum": [
        "Urban Grand Hotel",
        "Urban Lifestyle Hotel",
        "Urban Resort",
        "Resort",
        "Heritage Hotel",
        "Boutique Hotel",
        "Wellness Retreat",
        "Wilderness Lodge",
        "Private-Island Hotel",
        "Members-Club Hybrid",
        "Branded Residence Ecosystem"
      ]
    },
    "strategicLens": {
      "type": "string",
      "enum": [
        "Trophy heritage asset",
        "Ultra-luxury urban ecosystem",
        "Members-club adjacency",
        "Lifestyle and cultural hotel",
        "Adaptive reuse / conversion",
        "Wellness-led mixed use",
        "Neighbourhood destination",
        "Business-travel flagship",
        "Luxury-brand real-estate platform",
        "Palace as luxury ecosystem",
        "View-led / location-scarce asset",
        "Ultra-private mansion",
        "Heritage conversion / reinvention",
        "Design-led urban lifestyle hotel"
      ]
    },
    "distinction": {
      "type": "string",
      "enum": [
        "Best for Business Travel",
        "Pricing Power",
        "Hospitality Ecosystem",
        "Independent Excellence",
        "Urban Resort",
        "Best Repositioning",
        "Best New Hotel",
        "Best Hotel Restaurant",
        "Most Investable Hospitality Concept",
        "DMW One to Watch"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": ["string", "null"]
        },
        "collection": {
          "type": ["string", "null"]
        },
        "operator": {
          "type": ["string", "null"]
        },
        "owner": {
          "type": ["string", "null"]
        },
        "ownershipPubliclyConfirmed": {
          "type": "boolean",
          "default": false
        },
        "designer": {
          "type": ["string", "null"]
        },
        "architect": {
          "type": ["string", "null"]
        }
      }
    },
    "propertyFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openingYear": {
          "type": ["integer", "null"],
          "minimum": 1000
        },
        "lastMajorRenovationYear": {
          "type": ["integer", "null"],
          "minimum": 1000
        },
        "roomCount": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "suiteCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "checkInTime": {
          "type": ["string", "null"]
        },
        "checkOutTime": {
          "type": ["string", "null"]
        },
        "propertyType": {
          "type": ["string", "null"]
        },
        "seasonality": {
          "type": ["string", "null"]
        }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "indicativeFrom": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "indicativeTo": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "typicalRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "rateLabel": {
          "type": ["string", "null"]
        },
        "taxesIncluded": {
          "type": ["boolean", "null"]
        },
        "rateBasis": {
          "type": ["string", "null"]
        },
        "rateObservedAt": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "amenity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "category",
        "available"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "Food and Drink",
            "Wellness",
            "Business",
            "Transport",
            "Rooms",
            "Family",
            "Accessibility",
            "Leisure",
            "Other"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "detail": {
          "type": ["string", "null"]
        },
        "venueName": {
          "type": ["string", "null"]
        },
        "icon": {
          "type": ["string", "null"],
          "description": "Lucide icon component name."
        }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Restaurant",
            "Bar",
            "Café",
            "Bakery",
            "Nightclub",
            "Rooftop",
            "Lounge",
            "Private Dining",
            "Other"
          ]
        },
        "description": {
          "type": ["string", "null"]
        },
        "strategicRole": {
          "type": ["string", "null"]
        },
        "mealPeriods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Breakfast",
              "Brunch",
              "Lunch",
              "Afternoon Tea",
              "Dinner",
              "Late Night"
            ]
          },
          "uniqueItems": true,
          "default": []
        },
        "attractsNonResidents": {
          "type": ["boolean", "null"]
        },
        "recognition": {
          "type": ["string", "null"]
        },
        "officialUrl": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hospitalityProposition": {
          "type": ["string", "null"]
        },
        "atmosphere": {
          "type": ["string", "null"]
        },
        "intendedClientele": {
          "type": ["string", "null"]
        },
        "designLogic": {
          "type": ["string", "null"]
        },
        "locationLogic": {
          "type": ["string", "null"]
        },
        "hospitalityStrategy": {
          "type": ["string", "null"]
        },
        "revenueStrategy": {
          "type": ["string", "null"]
        },
        "pricingPowerThesis": {
          "type": ["string", "null"]
        },
        "assetLogic": {
          "type": ["string", "null"]
        },
        "competitiveMoat": {
          "type": ["string", "null"]
        },
        "strategicOpportunity": {
          "type": ["string", "null"]
        },
        "investorQuestion": {
          "type": ["string", "null"]
        }
      }
    },
    "businessTravel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": ["string", "null"]
        },
        "suitability": {
          "type": ["string", "null"],
          "enum": [
            "Exceptional",
            "Strong",
            "Good",
            "Limited",
            "Not Assessed",
            null
          ]
        },
        "locationEfficiency": {
          "type": ["string", "null"]
        },
        "workspace": {
          "type": ["string", "null"]
        },
        "connectivity": {
          "type": ["string", "null"]
        },
        "meetingSuitability": {
          "type": ["string", "null"]
        },
        "privacy": {
          "type": ["string", "null"]
        },
        "sleepAndNoise": {
          "type": ["string", "null"]
        },
        "serviceSpeed": {
          "type": ["string", "null"]
        },
        "breakfastPracticality": {
          "type": ["string", "null"]
        },
        "soloTravellerSuitability": {
          "type": ["string", "null"]
        }
      }
    },
    "rooms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": ["string", "null"]
        },
        "minimumSizeSqm": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "maximumStandardRoomSizeSqm": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "workspace": {
          "type": ["string", "null"]
        },
        "storage": {
          "type": ["string", "null"]
        },
        "bathroom": {
          "type": ["string", "null"]
        },
        "lighting": {
          "type": ["string", "null"]
        },
        "technology": {
          "type": ["string", "null"]
        },
        "views": {
          "type": ["string", "null"]
        },
        "spatialStrength": {
          "type": ["string", "null"]
        },
        "spatialCompromise": {
          "type": ["string", "null"]
        }
      }
    },
    "pricingIntelligence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "collecting",
            "complete"
          ]
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "roomBasis": {
          "type": ["string", "null"]
        },
        "occupancyBasis": {
          "type": ["string", "null"]
        },
        "taxesIncluded": {
          "type": ["boolean", "null"]
        },
        "observationStart": {
          "type": ["string", "null"],
          "format": "date"
        },
        "observationEnd": {
          "type": ["string", "null"],
          "format": "date"
        },
        "collectionDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "sourceMethod": {
          "type": ["string", "null"]
        },
        "medianObservedRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "lowestObservedRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "highestObservedRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "bestValuePeriod": {
          "type": ["string", "null"]
        },
        "peakPeriod": {
          "type": ["string", "null"]
        },
        "weekdayWeekendObservation": {
          "type": ["string", "null"]
        },
        "dmwInterpretation": {
          "type": ["string", "null"]
        },
        "dataPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pricePoint"
          },
          "default": []
        },
        "eventMarkers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventMarker"
          },
          "default": []
        },
        "limitations": {
          "type": ["string", "null"]
        }
      }
    },
    "pricePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "rate"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "available": {
          "type": ["boolean", "null"]
        },
        "roomCategory": {
          "type": ["string", "null"]
        },
        "rateType": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "eventMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "label"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string"
        },
        "eventType": {
          "type": ["string", "null"]
        }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hotelName",
        "reasonIncluded"
      ],
      "properties": {
        "hotelId": {
          "type": ["string", "null"]
        },
        "hotelName": {
          "type": "string"
        },
        "reasonIncluded": {
          "type": "string"
        },
        "relativePricePosition": {
          "type": ["string", "null"]
        },
        "positioningDifference": {
          "type": ["string", "null"]
        },
        "amenityDifference": {
          "type": ["string", "null"]
        },
        "locationDifference": {
          "type": ["string", "null"]
        },
        "dmwInterpretation": {
          "type": ["string", "null"]
        }
      }
    },
    "rankingAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methodologyVersion": {
          "type": ["string", "null"]
        },
        "calculatedScore": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "editorialAdjustment": {
          "type": ["number", "null"],
          "minimum": -5,
          "maximum": 5
        },
        "finalScore": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": ["string", "null"],
          "enum": [
            "High",
            "Medium",
            "Developing",
            null
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rankingDimension"
          },
          "default": []
        },
        "editorialAdjustmentReason": {
          "type": ["string", "null"]
        },
        "internalNotes": {
          "type": ["string", "null"],
          "description": "Must never be rendered publicly."
        }
      }
    },
    "rankingDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "weight",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "confidence": {
          "type": "string",
          "enum": [
            "High",
            "Medium",
            "Developing"
          ]
        },
        "evidenceNote": {
          "type": ["string", "null"]
        }
      }
    },
    "fieldReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visitDateLabel",
        "nights",
        "travelPurpose",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "visitDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "visitDateLabel": {
          "type": "string",
          "description": "May state an approximate month or season."
        },
        "dateIsApproximate": {
          "type": "boolean",
          "default": false
        },
        "nights": {
          "type": "integer",
          "minimum": 1
        },
        "roomCategory": {
          "type": ["string", "null"]
        },
        "approximatePaidRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "rateBasis": {
          "type": ["string", "null"]
        },
        "travelPurpose": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "arrival": {
          "type": ["string", "null"]
        },
        "room": {
          "type": ["string", "null"]
        },
        "service": {
          "type": ["string", "null"]
        },
        "atmosphereAndClientele": {
          "type": ["string", "null"]
        },
        "foodAndDrink": {
          "type": ["string", "null"]
        },
        "amenitiesUsed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "returnIntention": {
          "type": ["string", "null"]
        },
        "thesisConfirmation": {
          "type": ["string", "null"]
        },
        "pullQuote": {
          "type": ["string", "null"]
        },
        "publishedAt": {
          "type": ["string", "null"],
          "format": "date"
        },
        "updatedAt": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "src",
        "alt",
        "rightsStatus"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string",
